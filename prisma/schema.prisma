generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  password  String
  role      String    @default("student")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  grupo     Int       @default(0)
  sessions  Session[]

  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// Asignatura (Subject): entidad padre del temario. Añadida de forma aditiva
// para el módulo 4.1 (RF-ASG-*). La relación con Topic es opcional, por lo que
// los temas existentes siguen funcionando sin asignatura asociada.
model Subject {
  id                 String   @id @default(cuid())
  code               String   @unique
  slug               String   @unique
  name               String
  credits            Int      @default(0)
  objective          String   @db.Text
  specificObjectives String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  topics             Topic[]

  @@index([code])
  @@index([slug])
}

model Topic {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  order         Int      @default(0)
  parte         String?  // Agrupación: "Preliminares", "Parte 1: Vectores Aleatorios", etc.
  parentSlug    String?  // Slug del padre para subtemas
  subjectId     String?  // Asignatura a la que pertenece (opcional, fase aditiva 4.1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  visibleGroup1 Boolean  @default(true)
  visibleGroup2 Boolean  @default(true)

  contents      Content[]
  links         Link[]
  subject       Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([parte])
  @@index([parentSlug])
  @@index([subjectId])
  @@index([visibleGroup1])
  @@index([visibleGroup2])
}

model Content {
  id        String   @id @default(cuid())
  topicId   String
  type      String   // "TEXT", "VIDEO", "MATERIAL"
  content   String   @db.Text
  order     Int      @default(0)
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

model Link {
  id        String   @id @default(cuid())
  topicId   String
  title     String
  url       String
  order     Int      @default(0)
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}
